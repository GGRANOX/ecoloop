{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "frontend",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__path=/api/:path*" },
    { "source": "/docs", "destination": "/api/index?__path=/docs" },
    { "source": "/openapi.json", "destination": "/api/index?__path=/openapi.json" }
  ]
}
